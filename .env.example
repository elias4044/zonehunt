# Leave empty in production: the app talks to the same origin that serves it.
# For `next dev`, point it at your local PocketBase:
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090

# Map tiles. The OSM default is fine for trying things out, but its usage policy
# frowns on heavy traffic. Swap in MapTiler, Stadia, or your own tile server for real use.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
